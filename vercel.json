{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build && node ../scripts/build_vercel.mjs",
      "outputDirectory": "vercel-dist",
      "rewrites": [
        { "source": "/dashboard", "destination": "/static/index.html" },
        { "source": "/threat-dashboard", "destination": "/static/threat_dashboard.html" },
        { "source": "/", "destination": "/static/landing.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
