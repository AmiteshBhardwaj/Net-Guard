# Use the Supabase PostgreSQL connection string on the backend only.
NETGUARD_DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require

# Backend settings.
NETGUARD_CORS_ORIGINS=https://<your-vercel-domain>
NETGUARD_CAPTURE_MODE=agent
NETGUARD_AGENT_TOKEN=<generate-a-long-random-token>

# Set this in the Vercel project build environment, not the backend.
NETGUARD_API_URL=https://<your-backend-domain>
